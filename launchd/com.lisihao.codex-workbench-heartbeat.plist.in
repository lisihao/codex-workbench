<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lisihao.codex-workbench-heartbeat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-T</string>
    <string>-o</string>
    <string>BatchMode=yes</string>
    <string>-o</string>
    <string>ConnectTimeout=15</string>
    <string>-o</string>
    <string>ServerAliveInterval=10</string>
    <string>-o</string>
    <string>ServerAliveCountMax=2</string>
    <string>__AUTHORITY_SSH_ALIAS__</string>
    <string>exec &quot;$HOME/Library/Application Support/Codex Workbench/app/bin/codex-workbench&quot; client heartbeat --client-id &quot;__CLIENT_ID__&quot; --kind macbook</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__LOG_ROOT__/heartbeat.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_ROOT__/heartbeat.error.log</string>
</dict>
</plist>
