<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lisihao.codex-workbench-capabilities</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP_ROOT__/scripts/python-runtime</string>
    <string>-m</string>
    <string>codex_workbench</string>
    <string>--home</string>
    <string>__STATE_ROOT__</string>
    <string>capabilities</string>
    <string>refresh</string>
    <string>--activate-safe</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__USER_HOME__</string>
    <key>PYTHONPATH</key>
    <string>__APP_ROOT__/src</string>
    <key>CODEX_WORKBENCH_HOME</key>
    <string>__STATE_ROOT__</string>
    <key>CODEX_WORKBENCH_CODEX</key>
    <string>__CODEX_BINARY__</string>
    <key>CODEX_HOME</key>
    <string>__CODEX_HOME__</string>
    <key>CODEX_WORKBENCH_PROCESS_HOME</key>
    <string>__PROCESS_HOME__</string>
    <key>CODEX_WORKBENCH_CLAUDE</key>
    <string>__CLAUDE_BINARY__</string>
    <key>CODEX_WORKBENCH_QUOTA_SNAPSHOT_FILE</key>
    <string>__QUOTA_SNAPSHOT_FILE__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>__CAPABILITY_REFRESH_SECONDS__</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__STATE_ROOT__/logs/capabilities.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE_ROOT__/logs/capabilities.error.log</string>
</dict>
</plist>
